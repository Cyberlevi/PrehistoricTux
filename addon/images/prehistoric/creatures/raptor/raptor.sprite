(supertux-sprite
  ; Canonical production artwork faces RIGHT.
  ; SuperTux enemy direction actions must therefore use the source frames for
  ; "right" and mirror them for "left".
  (action
    (name "right")
    (hitbox 10 14 44 30)
    (fps 9)
    (images "raptor-walk-0.surface"
            "raptor-walk-1.surface"
            "raptor-walk-2.surface"
            "raptor-walk-3.surface")
  )
  (action
    (name "left")
    (hitbox 10 14 44 30)
    (fps 9)
    (mirror-action "right")
  )
  (action
    (name "squished-right")
    (hitbox 10 20 44 20)
    (images "raptor-squished.surface")
  )
  (action
    (name "squished-left")
    (hitbox 10 20 44 20)
    (mirror-action "squished-right")
  )
  (action
    (name "melting")
    (hitbox 10 20 44 20)
    (images "raptor-squished.surface")
  )
  (action
    (name "ground-melting")
    (hitbox 10 20 44 20)
    (images "raptor-squished.surface")
  )
)
