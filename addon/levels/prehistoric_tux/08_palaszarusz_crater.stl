(supertux-level
  (version 3)
  (name (_ "Palaszarusz Crater"))
  (author "Tarnóczi Levente & Hanna")
  (license "CC-BY-SA 4.0 International")
  (target-time 210)
  (allow-item-pocket "inherit")
  (icon "")
  (icon-locked "")
  (statistics
    (enable-coins #t)
    (enable-secrets #t)
  )
  (tileset "/images/prehistoric/tiles.strf")
  (sector
    (name "main")
    (init-script "import(\"levels/prehistoric_tux/08_palaszarusz_crater.nut\");")
    (ambient-light (color 0.58 0.36 0.29))
    (gradient
      (top_color 0.10 0.04 0.06)
      (bottom_color 0.91 0.19 0.05)
    )
    (camera (name "Camera") (mode "normal"))
    (spawnpoint (name "main") (x 96) (y 768))

    (decal
      (z-pos -120)
      (sprite "/images/prehistoric/scenery/volcano-distant.png")
      (x 3072)
      (y 352)
    )
    (decal
      (z-pos -80)
      (sprite "/images/prehistoric/scenery/cliff-spire.png")
      (x 6176)
      (y 384)
    )

    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 3744)
      (y 704)
    )
    ; Final checkpoint before the boss arena.
    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 7424)
      (y 672)
    )

    (infoblock
      (z-pos 50)
      (message (_ "-Palaszarusz Crater
#The trail ends inside the volcano.
#The stolen egg is somewhere beyond the lava vents."))
      (fadetransition #t)
      (x 640)
      (y 704)
    )
    (infoblock
      (z-pos 50)
      (message (_ "-The Roar Below
#The ground shakes in a steady rhythm.
#There is nowhere left for the Palaszarusz to run."))
      (fadetransition #t)
      (x 7200)
      (y 608)
    )

    ; Approach threats.
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 1312) (y 736) (glinting #f))
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 2912) (y 704) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 4352) (y 352) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 5792) (y 672) (glinting #t))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 2464) (y 96))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 5088) (y 64))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 6848) (y 64))

    ; Boss arena hazards.
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 8256) (y 64))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 8768) (y 64))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 9280) (y 64))

    (scriptedobject
      (z-pos 60)
      (physic-enabled #t)
      (solid #f)
      (visible #f)
      (name "PALASZARUSZ_BOSS")
      (sprite "/images/prehistoric/boss/palaszarusz/palaszarusz.sprite")
      (hit-script "Tux.kill(false);")
      (x 9568)
      (y 620)
    )
    (scriptedobject
      (z-pos 55)
      (physic-enabled #f)
      (solid #f)
      (visible #f)
      (name "STOLEN_EGG_FINAL")
      (sprite "/images/prehistoric/story/stolen-egg.sprite")
      (x 8896)
      (y 640)
    )

    ; Battle starts after the final checkpoint.
    (scripttrigger
      (oneshot #t)
      (script "palaszarusz_battle();")
      (button #f)
      (width 48)
      (height 544)
      (x 7872)
      (y 320)
    )

    ; Coin line guides the approach but clears the arena visually.
    (coin (z-pos 49) (x 1664) (y 576))
    (coin (z-pos 49) (x 1728) (y 544))
    (coin (z-pos 49) (x 1792) (y 512))
    (coin (z-pos 49) (x 4288) (y 480))
    (coin (z-pos 49) (x 4352) (y 448))
    (coin (z-pos 49) (x 4416) (y 416))
    (coin (z-pos 49) (x 6912) (y 480))
    (coin (z-pos 49) (x 6976) (y 448))
    (coin (z-pos 49) (x 7040) (y 416))

    (secretarea
      (message (_ "Crater fossil shelf discovered!"))
      (width 288)
      (height 160)
      (x 6048)
      (y 480)
    )
    (secretarea
      (message (_ "Palaszarusz nesting scar discovered!"))
      (width 288)
      (height 160)
      (x 7552)
      (y 448)
    )

    ; Fallback finish beyond the boss arena.
    (sequencetrigger
      (sequence "endsequence")
      (width 32)
      (height 576)
      (x 10176)
      (y 256)
    )

    (tilemap
      (solid #t)
      (z-pos 0)
      (name "Palaszarusz Crater Terrain")
      (width 320)
      (height 30)
      (tiles -6031 0 -12 6 -605 0 -12 6 -34 0 -12 6 -520 0 -45 8 -213 0 -55 8 -7 0 -45 7 -155 0 -51 8 -7 0 -55 7 -7 0 -45 7 -7 0 -141 8 -7 0 -51 7 -7 0 -55 7 -7 0 -45 7 -7 0 -141 7 -7 0 -51 7 -7 0 -55 7 -7 0 -45 7 -7 0 -141 7 -7 0 -51 7 -7 0 -55 7 -7 0 -45 7 -7 0 -141 7 -7 9 -51 7 -7 9 -55 7 -7 9 -45 7 -7 9 -141 7 -7 9 -51 7 -7 9 -55 7 -7 9 -45 7 -7 9 -82 7)
    )
  )
)
