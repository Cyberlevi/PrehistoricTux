(supertux-level
  (version 3)
  (name (_ "Fernwood Canopy"))
  (author "Tarnóczi Levente & Hanna")
  (license "CC-BY-SA 4.0 International")
  (target-time 165)
  (allow-item-pocket "inherit")
  (icon "")
  (icon-locked "")
  (statistics
    (enable-coins #t)
    (enable-secrets #t)
  )
  (tileset "/images/prehistoric/tiles.strf")
  (sector
    (name "main")
    (ambient-light (color 0.70 0.86 0.63))
    (gradient
      (top_color 0.13 0.34 0.26)
      (bottom_color 0.66 0.78 0.45)
    )
    (camera (name "Camera") (mode "normal"))
    (spawnpoint (name "main") (x 96) (y 768))

    (decal
      (z-pos -80)
      (sprite "/images/prehistoric/scenery/sauropod-distant.surface")
      (x 1664)
      (y 576)
    )

    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 4352)
      (y 736)
    )
    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 8192)
      (y 736)
    )

    (infoblock
      (z-pos 50)
      (message (_ "-Fernwood Canopy
#The tracks leave the ground here.
#Use the high branches, but watch the sky."))
      (fadetransition #t)
      (x 704)
      (y 704)
    )
    (infoblock
      (z-pos 50)
      (message (_ "-Broken Feathers
#The flying hunters circle lower near the cliffs.
#The cave entrance cannot be far."))
      (fadetransition #t)
      (x 8000)
      (y 672)
    )

    ; Ground hunters.
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 1216) (y 768) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 2752) (y 768) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 5056) (y 768) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 7104) (y 768) (glinting #t))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 9376) (y 768) (glinting #f))

    ; Snakes guard low routes while pterosaurs pressure high routes.
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 3456) (y 736) (glinting #f))
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 6144) (y 736) (glinting #f))
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 8832) (y 736) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 2304) (y 448) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 4672) (y 384) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 6944) (y 352) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 9216) (y 352) (glinting #t))

    ; Coin arcs show the safer jump lines.
    (coin (z-pos 49) (x 1536) (y 640))
    (coin (z-pos 49) (x 1600) (y 608))
    (coin (z-pos 49) (x 1664) (y 576))
    (coin (z-pos 49) (x 1728) (y 608))
    (coin (z-pos 49) (x 1792) (y 640))
    (coin (z-pos 49) (x 4448) (y 544))
    (coin (z-pos 49) (x 4512) (y 512))
    (coin (z-pos 49) (x 4576) (y 480))
    (coin (z-pos 49) (x 4640) (y 512))
    (coin (z-pos 49) (x 4704) (y 544))
    (coin (z-pos 49) (x 8992) (y 512))
    (coin (z-pos 49) (x 9056) (y 480))
    (coin (z-pos 49) (x 9120) (y 448))

    (secretarea
      (message (_ "Ancient treetop nest discovered!"))
      (width 320)
      (height 160)
      (x 4512)
      (y 432)
    )
    (secretarea
      (message (_ "Hidden cliff fossil discovered!"))
      (width 288)
      (height 160)
      (x 9344)
      (y 448)
    )

    (sequencetrigger
      (sequence "endsequence")
      (width 32)
      (height 448)
      (x 11392)
      (y 416)
    )

    (tilemap
      (solid #t)
      (z-pos 0)
      (name "Fernwood Terrain")
      (width 360)
      (height 30)
      (tiles -6041 0 -4 2 -10 6 -280 0 -14 2 -59 0 5 -215 0 -15 2 -62 0 1 -66 0 5 -41 0 -15 6 -99 0 -16 2 -51 0 1 -69 0 1 -39 0 -16 2 -11 0 5 -48 0 5 -61 0 -11 2 -42 0 1 -58 0 1 -44 0 -15 2 -10 0 1 -46 0 1 -19 0 5 -48 0 5 -114 0 1 -31 0 -16 2 -11 0 1 -52 0 1 -16 0 1 -46 0 1 -19 0 5 -11 0 -15 6 -22 0 5 -40 0 -17 2 -57 0 1 -40 0 1 -17 0 1 -12 0 -13 2 -27 0 1 -16 0 1 -11 0 -10 2 -25 0 1 -19 0 5 -48 0 5 -10 0 -9 6 -31 0 1 -36 0 -16 2 -11 0 1 -40 0 1 -17 0 1 -52 0 1 -16 0 1 -46 0 1 -19 0 5 -48 0 5 -50 0 1 -63 0 1 -40 0 1 -17 0 1 -52 0 1 -16 0 1 -46 0 1 -19 0 5 -48 0 5 -50 0 1 -63 0 1 -40 0 1 -17 0 1 -52 0 1 -16 0 1 -46 0 1 -19 0 5 -48 0 5 -22 0 -28 2 1 -23 2 -7 0 -33 2 1 -19 2 -7 0 -14 2 1 -17 2 1 -29 2 -9 0 -14 2 1 -16 2 1 -25 2 -8 0 -13 2 1 -16 2 -3 6 5 -30 6 -8 0 -10 6 5 -22 6 -52 1 -7 0 -53 1 -7 0 -62 1 -9 0 -57 1 -8 0 -30 1 -34 5 -8 0 -33 5 -52 1 -7 0 -53 1 -7 0 -62 1 -9 0 -57 1 -8 0 -30 1 -34 5 -8 0 -33 5 -52 1 -7 0 -53 1 -7 0 -62 1 -9 0 -57 1 -8 0 -30 1 -34 5 -8 0 -33 5)
    )
  )
)
