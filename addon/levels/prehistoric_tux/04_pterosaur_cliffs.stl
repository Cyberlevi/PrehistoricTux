(supertux-level
  (version 3)
  (name (_ "Pterosaur Cliffs"))
  (author "Tarnóczi Levente & Hanna")
  (license "CC-BY-SA 4.0 International")
  (target-time 185)
  (allow-item-pocket "inherit")
  (icon "")
  (icon-locked "")
  (statistics
    (enable-coins #t)
    (enable-secrets #t)
  )
  (tileset "/images/prehistoric/tiles.strf")
  (sector
    (name "main")
    (init-script "import(\"levels/prehistoric_tux/04_pterosaur_cliffs.nut\");")
    (ambient-light (color 0.78 0.86 0.72))
    (gradient
      (top_color 0.17 0.35 0.45)
      (bottom_color 0.72 0.66 0.43)
    )
    (camera (name "Camera") (mode "normal"))
    (spawnpoint (name "main") (x 96) (y 960))

    (decal
      (z-pos -100)
      (sprite "/images/prehistoric/scenery/cliff-spire.png")
      (x 2688)
      (y 544)
    )
    (decal
      (z-pos -100)
      (sprite "/images/prehistoric/scenery/cliff-spire.png")
      (x 6656)
      (y 416)
    )
    (decal
      (z-pos -10)
      (sprite "/images/prehistoric/scenery/pterosaur-nest.png")
      (x 9280)
      (y 384)
    )

    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 4096)
      (y 832)
    )
    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 8128)
      (y 640)
    )

    (infoblock
      (z-pos 50)
      (message (_ "-Pterosaur Cliffs
#The egg trail climbs into the wind.
#Use the gusts, but never trust the sky to stay quiet."))
      (fadetransition #t)
      (x 608)
      (y 896)
    )
    (infoblock
      (z-pos 50)
      (message (_ "-The Nesting Wall
#The largest shadows circle above the nests.
#Move between gusts and do not linger in open air."))
      (fadetransition #t)
      (x 8512)
      (y 576)
    )

    ; Named wind columns are controlled by the level script.
    (wind
      (z-pos -99)
      (blowing #f)
      (speed-x 120)
      (speed-y -460)
      (acceleration 120)
      (affects-badguys #t)
      (affects-objects #t)
      (affects-player #t)
      (width 384)
      (height 672)
      (name "GUST_A")
      (x 1696)
      (y 352)
    )
    (wind
      (z-pos -99)
      (blowing #f)
      (speed-x 180)
      (speed-y -500)
      (acceleration 130)
      (affects-badguys #t)
      (affects-objects #t)
      (affects-player #t)
      (width 416)
      (height 672)
      (name "GUST_B")
      (x 4384)
      (y 256)
    )
    (wind
      (z-pos -99)
      (blowing #f)
      (speed-x -160)
      (speed-y -520)
      (acceleration 140)
      (affects-badguys #t)
      (affects-objects #t)
      (affects-player #t)
      (width 448)
      (height 704)
      (name "GUST_C")
      (x 7136)
      (y 128)
    )
    (wind
      (z-pos -99)
      (blowing #f)
      (speed-x 220)
      (speed-y -560)
      (acceleration 150)
      (affects-badguys #t)
      (affects-objects #t)
      (affects-player #t)
      (width 448)
      (height 768)
      (name "GUST_D")
      (x 9984)
      (y 64)
    )

    ; Gust triggers give each vertical crossing a readable start/stop window.
    (scripttrigger (oneshot #t) (script "gust_a();") (button #f) (width 48) (height 384) (x 1472) (y 608))
    (scripttrigger (oneshot #t) (script "gust_b();") (button #f) (width 48) (height 448) (x 4160) (y 480))
    (scripttrigger (oneshot #t) (script "gust_c();") (button #f) (width 48) (height 512) (x 6912) (y 352))
    (scripttrigger (oneshot #t) (script "gust_d();") (button #f) (width 48) (height 576) (x 9760) (y 224))

    ; Moving cliff platforms bridge the most exposed ravines.
    (path
      (name "cliff-platform-path-1")
      (path
        (adapt_speed #f)
        (node (x 1952) (y 768) (time 2.4) (easing "EaseQuadInOut"))
        (node (x 2464) (y 640) (time 2.4) (easing "EaseQuadInOut"))
      )
    )
    (platform
      (z-pos 45)
      (handle (scale_x 0) (scale_y 0) (offset_x 0) (offset_y 0))
      (path-ref "cliff-platform-path-1")
      (sprite "/images/prehistoric/objects/platforms/cliff-platform.sprite")
    )

    (path
      (name "cliff-platform-path-2")
      (path
        (adapt_speed #f)
        (node (x 5056) (y 608) (time 2.8) (easing "EaseQuadInOut"))
        (node (x 5600) (y 480) (time 2.8) (easing "EaseQuadInOut"))
      )
    )
    (platform
      (z-pos 45)
      (handle (scale_x 0) (scale_y 0) (offset_x 0) (offset_y 0))
      (path-ref "cliff-platform-path-2")
      (sprite "/images/prehistoric/objects/platforms/cliff-platform.sprite")
    )

    (path
      (name "cliff-platform-path-3")
      (path
        (adapt_speed #f)
        (node (x 7808) (y 416) (time 3.0) (easing "EaseQuadInOut"))
        (node (x 8384) (y 320) (time 3.0) (easing "EaseQuadInOut"))
      )
    )
    (platform
      (z-pos 45)
      (handle (scale_x 0) (scale_y 0) (offset_x 0) (offset_y 0))
      (path-ref "cliff-platform-path-3")
      (sprite "/images/prehistoric/objects/platforms/cliff-platform.sprite")
    )

    ; Sky pressure ramps up over the level.
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 1312) (y 560) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 3264) (y 416) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 4896) (y 352) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 6336) (y 320) (glinting #t))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 7680) (y 224) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 9024) (y 192) (glinting #t))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 10368) (y 160) (glinting #t))

    ; Ground pressure is lighter here, preserving the level's aerial identity.
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 2880) (y 864) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 5920) (y 672) (glinting #f))
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 8736) (y 544) (glinting #f))

    ; Coin arcs reveal the safe gust trajectories.
    (coin (z-pos 49) (x 1728) (y 768))
    (coin (z-pos 49) (x 1792) (y 704))
    (coin (z-pos 49) (x 1856) (y 640))
    (coin (z-pos 49) (x 1920) (y 576))
    (coin (z-pos 49) (x 1984) (y 544))
    (coin (z-pos 49) (x 4480) (y 608))
    (coin (z-pos 49) (x 4544) (y 544))
    (coin (z-pos 49) (x 4608) (y 480))
    (coin (z-pos 49) (x 4672) (y 416))
    (coin (z-pos 49) (x 7200) (y 448))
    (coin (z-pos 49) (x 7264) (y 384))
    (coin (z-pos 49) (x 7328) (y 320))
    (coin (z-pos 49) (x 10048) (y 320))
    (coin (z-pos 49) (x 10112) (y 256))
    (coin (z-pos 49) (x 10176) (y 192))

    (secretarea
      (message (_ "Abandoned pterosaur nest discovered!"))
      (width 320)
      (height 160)
      (x 9184)
      (y 352)
    )
    (secretarea
      (message (_ "Wind-carved fossil ledge discovered!"))
      (width 288)
      (height 160)
      (x 10816)
      (y 256)
    )

    (sequencetrigger
      (sequence "endsequence")
      (width 32)
      (height 640)
      (x 11392)
      (y 128)
    )

    (tilemap
      (solid #t)
      (z-pos 0)
      (name "Pterosaur Cliff Terrain")
      (width 360)
      (height 36)
      (tiles -4660 0 -13 6 -655 0 -14 6 -999 0 -14 6 -100 0 -25 6 -335 0 -25 5 -277 0 -36 6 -22 0 -25 5 -155 0 -12 6 -110 0 -36 5 -22 0 -25 5 -277 0 -36 5 -22 0 -25 5 -87 0 -12 6 -111 0 -45 6 -22 0 -36 5 -22 0 -25 5 -210 0 -45 5 -22 0 -36 5 -22 0 -25 5 -210 0 -45 5 -22 0 -36 5 -22 0 -25 5 -18 0 -14 6 -111 0 -45 6 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5 -143 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5 -143 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5 -76 0 -45 6 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5 -76 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5 -76 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5 -54 6 -22 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -79 5 -22 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -79 5 -22 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -79 5 -22 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -79 5 -22 0 -45 5 -22 0 -45 5 -22 0 -45 5 -22 0 -36 5 -22 0 -25 5)
    )
  )
)
