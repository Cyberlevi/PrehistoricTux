(supertux-level
  (version 3)
  (save-version 2)
  (name (_ "The Prehistoric Rift"))
  (author "Tarnóczi Levente & Hanna")
  (license "CC-BY-SA 4.0 International")
  (allow-item-pocket "on")
  (icon "/images/worlds/icon/icyisland.png")
  (icon-locked "/images/worlds/locked/icyisland.png")
  (bkg "/images/worlds/background/icyisland.png")
  (sector
    (name "main")
    (ambient-light (color 1 1 1))
    (music (file "/music/antarctic/worldmap_ice.music"))
    (level
      (z-pos -1000)
      (level "00_prologue.stl")
      (auto-play #t)
      (color 0.6 0.8 1)
      (x 3)
      (y 8)
    )
    (level (z-pos 50) (level "01_lost_egg_valley.stl") (x 4) (y 8))
    (level (z-pos 50) (level "02_dinosaur_trail.stl") (x 6) (y 8))
    (level (z-pos 50) (level "03_ancient_caves.stl") (x 8) (y 8))
    (level (z-pos 50) (level "04_pterosaur_cliffs.stl") (x 10) (y 8))
    (level (z-pos 50) (level "05_flooded_ruins.stl") (x 12) (y 8))
    (level (z-pos 50) (level "06_bonefield.stl") (x 14) (y 8))
    (level (z-pos 50) (level "07_nesting_grounds.stl") (x 16) (y 8))
    (level (z-pos 50) (level "08_palaszarusz_crater.stl") (x 18) (y 8))
    (worldmap-spawnpoint (z-pos 50) (name "main") (x 3) (y 8))
    (tilemap
      (solid #t)
      (z-pos 0)
      (name "pathing")
      (width 22)
      (height 18)
      (tiles -179 0 10 -15 20 11 -200 0)
    )
  )
  (tileset "/images/ice_world.strf")
)
