(supertux-level
  (version 3)
  (name (_ "Bonefield at Dusk"))
  (author "Tarnóczi Levente & Hanna")
  (license "CC-BY-SA 4.0 International")
  (target-time 175)
  (allow-item-pocket "inherit")
  (icon "")
  (icon-locked "")
  (statistics
    (enable-coins #t)
    (enable-secrets #t)
  )
  (tileset "/images/prehistoric/tiles.strf")
  (sector
    (name "main")
    (ambient-light (color 0.54 0.45 0.50))
    (gradient
      (top_color 0.16 0.10 0.25)
      (bottom_color 0.86 0.34 0.18)
    )
    (camera (name "Camera") (mode "normal"))
    (spawnpoint (name "main") (x 96) (y 768))

    (decal
      (z-pos -140)
      (sprite "/images/prehistoric/scenery/dusk-sun.surface")
      (x 2944)
      (y 160)
    )
    (decal
      (z-pos -10)
      (sprite "/images/prehistoric/scenery/giant-ribs.surface")
      (x 2112)
      (y 576)
    )
    (decal
      (z-pos -12)
      (sprite "/images/prehistoric/scenery/bone-arch.surface")
      (x 5504)
      (y 544)
    )
    (decal
      (z-pos -8)
      (sprite "/images/prehistoric/scenery/fossil-skull.surface")
      (x 8448)
      (y 608)
    )

    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 3904)
      (y 704)
    )
    (firefly
      (sprite "/images/prehistoric/objects/checkpoint/checkpoint-totem.sprite")
      (z-pos 0)
      (x 7808)
      (y 672)
    )

    (infoblock
      (z-pos 50)
      (message (_ "-Bonefield at Dusk
#The valley goes quiet as the sun falls.
#Ancient bones mark a trail toward the nesting grounds."))
      (fadetransition #t)
      (x 640)
      (y 704)
    )
    (infoblock
      (z-pos 50)
      (message (_ "-The Broken Giant
#These bones are older than the valley paths.
#Fresh claw marks cut across them in the direction of the crater."))
      (fadetransition #t)
      (x 5440)
      (y 608)
    )

    ; Raptors become the dominant threat in the open field.
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 1344) (y 736) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 2432) (y 736) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 4672) (y 704) (glinting #f))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 6368) (y 672) (glinting #t))
    (snowball (sprite "/images/prehistoric/creatures/raptor/raptor.sprite") (z-pos 50) (direction "left") (x 9024) (y 672) (glinting #f))

    ; Snakes hide under the fossil shelves.
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 3264) (y 704) (glinting #f))
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 7040) (y 672) (glinting #f))
    (smartball (sprite "/images/prehistoric/creatures/snake/snake.sprite") (z-pos 50) (direction "left") (x 10144) (y 640) (glinting #t))

    ; A few late pterosaurs keep the sky unsafe.
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 3712) (y 416) (glinting #f))
    (flyingsnowball (sprite "/images/prehistoric/creatures/ptero/ptero.sprite") (z-pos 50) (x 7488) (y 352) (glinting #f))

    ; Crumbling stone over the ravines.
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 1856) (y 128))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 4128) (y 128))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 6144) (y 96))
    (stalactite (type "rock") (sprite "/images/prehistoric/objects/stalactite/cave-stalactite.sprite") (glinting #f) (z-pos -1) (x 8896) (y 96))

    ; Reward arcs across the fossil ridges.
    (coin (z-pos 49) (x 1792) (y 576))
    (coin (z-pos 49) (x 1856) (y 544))
    (coin (z-pos 49) (x 1920) (y 512))
    (coin (z-pos 49) (x 1984) (y 544))
    (coin (z-pos 49) (x 2048) (y 576))
    (coin (z-pos 49) (x 5376) (y 512))
    (coin (z-pos 49) (x 5440) (y 480))
    (coin (z-pos 49) (x 5504) (y 448))
    (coin (z-pos 49) (x 5568) (y 480))
    (coin (z-pos 49) (x 5632) (y 512))
    (coin (z-pos 49) (x 8704) (y 480))
    (coin (z-pos 49) (x 8768) (y 448))
    (coin (z-pos 49) (x 8832) (y 416))

    (secretarea
      (message (_ "Giant rib fossil chamber discovered!"))
      (width 320)
      (height 160)
      (x 2144)
      (y 496)
    )
    (secretarea
      (message (_ "Ancient predator skull discovered!"))
      (width 288)
      (height 160)
      (x 8448)
      (y 512)
    )

    (sequencetrigger
      (sequence "endsequence")
      (width 32)
      (height 480)
      (x 11392)
      (y 352)
    )

    (tilemap
      (solid #t)
      (z-pos 0)
      (name "Bonefield Terrain")
      (width 360)
      (height 30)
      (tiles -6087 0 -14 6 -231 0 -15 6 -221 0 -13 6 -529 0 -14 6 -94 0 -14 6 -474 0 -13 6 -515 0 -46 6 -195 0 -50 6 -69 0 -46 5 -72 0 -53 6 -70 0 -50 5 -8 0 -53 6 -8 0 -46 5 -65 6 -7 0 -53 5 -7 0 -55 6 -8 0 -50 5 -8 0 -53 5 -8 0 -111 5 -7 0 -53 5 -7 0 -55 5 -8 0 -50 5 -8 0 -53 5 -8 0 -111 5 -7 0 -53 5 -7 0 -55 5 -8 0 -50 5 -8 0 -53 5 -8 0 -111 5 -7 0 -53 5 -7 0 -55 5 -8 0 -50 5 -8 0 -53 5 -8 0 -111 5 -7 0 -53 5 -7 0 -55 5 -8 0 -50 5 -8 0 -53 5 -8 0 -46 5)
    )
  )
)
